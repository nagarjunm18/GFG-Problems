class Solution {
	public int maxSubarraySum(int[] arr, int k) {
		// Code here
		int windowSum = 0;
		int n = arr.length;
		for (int i = 0; i<k; i++) {
			windowSum += arr[i];
		}
		int maxSum = windowSum;
		for (int j = k; j<n; j++) {
			windowSum += arr[j]-arr[j - k];
			maxSum = Math.max(windowSum, maxSum);
		}
		return maxSum;
	}
}
