class Solution {
	public int maxConsecBits(int[] arr) {
		// code here
		int maxStreak = 1;
		int currentStreak = 1;
		
		for (int i = 1; i<arr.length; i++) {
			if (arr[i] == arr[i - 1]) {
				currentStreak++;
			} else {
				currentStreak = 1;
			}
			maxStreak = Math.max(maxStreak, currentStreak);
		}
		return maxStreak;
	}
}
